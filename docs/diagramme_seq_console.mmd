sequenceDiagram
    actor U as Utilisateur
    participant A as Application
    participant L as LecteurGrille
    participant S as Simulation
    participant G as Grille
    participant C as Cellule
    participant I as InterfaceConsole
    participant E as EcrivainGrille

    U->>A: main fichier.txt --console 10
    A->>L: lire("fichier.txt")
    L-->>A: Grille initiale
    A->>S: Simulation(grille, RegleConway)
    A->>I: creer(EcrivainGrille)
    A->>S: ajouterObservateur(I)
    A->>I: surGeneration(grille, 0)
    I->>E: ecrire(grille, "fichier_out", 0)

    loop tant que generation plus petite que N et non stable
        A->>S: iterer()
        S->>G: calculerSuivante(regle, tampon)
        loop pour chaque position
            G->>G: nombreVoisinesVivantes(p)
            G->>C: evoluer(regle, n)
            C-->>G: nouvelle Cellule
        end
        S->>S: echanger(grille, tampon)
        S->>I: surGeneration(grille, generation)
        I->>E: ecrire(grille, "fichier_out", generation)
    end

    A-->>U: fin de la simulation
