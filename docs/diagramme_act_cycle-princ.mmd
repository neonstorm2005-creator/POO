    lecture --> formatOk{"Format conforme ?"}
    formatOk -->|non| erreur["Afficher l'erreur de format"]
    erreur --> fin
    formatOk -->|oui| mode{"Mode demandé ?"}
    mode -->|console| sortie0["Créer le dossier de sortie et écrire la génération 0"]
    mode -->|graphique| fenetre["Ouvrir la fenêtre SFML"]
